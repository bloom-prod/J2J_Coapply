# --- Postgres (app + Drizzle) ---
# Primary connection string used by Next.js routes, crons, and drizzle-kit.
# Example: postgres://USER:PASS@HOST:5432/DB
DATABASE_URL=
# Compose / ops helpers for the jobless-db containers (optional for local Next.js)
JOBLESS_DB_USER=
JOBLESS_DB_PASSWORD=
JOBLESS_DB_NAME=
# Neon target for the nightly sync / backup cron (if used)
NEON_DATABASE_URL=

# --- MinIO root creds (compose / ops) ---
# Used by jobless-s3 containers; app resume uploads use the S3_* vars below.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Auth ---
# REQUIRED. Long random string used to sign/verify JWT auth tokens (HS256).
JWT_SECRET=

# --- Mailer (password reset + feedback emails) ---
# REQUIRED at runtime for /api/auth/forgot and /api/feedback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address shown in outbound mail (defaults to SMTP_USER if empty)
SMTP_FROM=
# Inbox for Feedback dialog submissions (defaults to admin@pxndey.com)
FEEDBACK_TO=admin@pxndey.com

# --- Resume storage (MinIO / S3-compatible) ---
# Used by lib/s3.ts for resume upload/download.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=jobless-resumes

# --- Groq (AI features) ---
# Preferred: GROQ_API_KEY. GROQ_API_MODEL is accepted as a legacy alias for the key.
GROQ_API_KEY=
GROQ_API_MODEL=

# --- Optional ---
# Set to "1" / "true" / "yes" to enable maintenance mode (middleware gate)
# MAINTENANCE_MODE=
