# ---------------------------------------------------------------------------
# PUBLIC Firebase web config — exposed to the browser (must be NEXT_PUBLIC_*).
# NOTE: the client no longer uses Firebase Auth/Firestore (JWT + Postgres now).
# These can be removed once Firebase is fully decommissioned.
#
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef

# ---------------------------------------------------------------------------
# Postgres — REQUIRED. The Drizzle ORM + all routes read/write here.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bloom

# ---------------------------------------------------------------------------
# JWT — REQUIRED. Long random string used to sign/verify auth tokens (HS256).
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-very-long-random-string

# Directory where uploaded resume PDFs are written. Served from public/uploads.
UPLOAD_DIR=/home/pxndey/srv/jobless/public/uploads/resumes

# ---------------------------------------------------------------------------
# SECRET Admin service account — server only (Route Handlers). NEVER NEXT_PUBLIC_.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Internal API secret for LeetCode sync service (server-to-server only)
INTERNAL_API_SECRET=change-me-to-a-random-string
